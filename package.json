{
  "name": "ssml-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:lib": "vite build --config vite.config.lib.ts",
    "preview": "vite preview",
    "eslint": "eslint . --ext .js,.cjs,.ts,.jsx,.tsx, --quiet --fix --ignore-path ./.gitignore",
    "prettier": "prettier . --loglevel warn --write './**/*.{js,jsx,ts,tsx,css,html,json}'",
    "stylelint": "stylelint ./**/*.{css,less,scss,sass} --fix",
    "type-check": "tsc"
  },
  "dependencies": {
    "pinyin-pro": "^3.26.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.8.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-react": "^7.28.0",
    "eslint-plugin-simple-import-sort": "^7.0.0",
    "less": "^4.1.3",
    "lint-staged": "^13.1.0",
    "playwright-core": "^1.62.1",
    "pre-commit": "^1.2.2",
    "prettier": "^2.5.1",
    "stylelint": "^14.16.1",
    "stylelint-config-recommended": "^9.0.0",
    "stylelint-config-sass-guidelines": "^9.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  },
  "lint-staged": {
    "./**/*.{js,cjs,ts,jsx,tsx}": [
      "eslint --fix --ignore-path ./.gitignore"
    ],
    "./**/*.{css,less,scss,sass}": [
      "stylelint --fix"
    ],
    "./**/*.{js,cjs,ts,css,scss,sass,html,json,md}": [
      "prettier . --loglevel warn --write "
    ]
  }
}
